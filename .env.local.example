# このファイルをコピーして「.env.local」という名前で保存し、値を埋めてください。
# .env.local はGitにコミットしないでください（.gitignoreに含まれています）。
# Netlifyにデプロイする際は、Netlifyのサイト設定 > Environment variables に
# 同じ内容を登録します（.env.localファイル自体はアップロードされません）。

# Supabaseプロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Settings > API の「service_role」キー（絶対に公開しない・ブラウザに送らない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 教員登録時に必要な「合言葉」。誰でも教員登録できてしまわないようにするための簡易な仕組みです。
# 好きな文字列に変更してください（例: 学校名+年度など）。この値を知っている人だけが教員登録できます。
TEACHER_INVITE_CODE=change-this-invite-code
